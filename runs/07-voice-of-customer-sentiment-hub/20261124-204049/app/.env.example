# Copy to .env and fill in the values
DOCUMENTDB_URI="mongodb://username:password@host:10260/?replicaSet=globaldb&tls=true&retryWrites=false"
# OpenAI / embeddings
OPENAI_API_KEY="your-openai-key"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM="1536"  # set to the selected embedding model's dimension
LLM_MODEL="gpt-3.5-turbo"
# Database
DATABASE_NAME="sample_customer_360_07"
