# Copy this file to .env and fill in the values
# Connection string to the Azure DocumentDB (MongoDB-compatible) cluster
# Example: mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256
DOCUMENTDB_URI=YOUR_DOCUMENTDB_CONNECTION_STRING

# Lang/LLM provider keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Embedding and chat model defaults (configurable)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
CHAT_MODEL=gpt-4o-mini

# Default database used by the sample
DOCUMENTDB_DB=sample_banking_04
