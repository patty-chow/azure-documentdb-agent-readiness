# Copy to .env and fill in the DOCUMENTDB_URI (do NOT check secrets into source control)
# Example (sanitized): DOCUMENTDB_URI="mongodb://username:password@your-documentdb-host:10255/?ssl=true&replicaSet=globaldb"
DOCUMENTDB_URI=__DOCUMENTDB_URI__
# Number of days until consent documents are removed by TTL. Default 365
TTL_DAYS=365
