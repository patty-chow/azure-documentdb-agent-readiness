# Azure DocumentDB connection (do NOT commit real secrets)
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<your-cluster>.mongocluster.cosmos.azure.com/?tls=true&retryWrites=true"

# OpenAI credentials
OPENAI_API_KEY="sk-..."
MODEL_NAME="gpt-4o-mini" # example; configurable
EMBEDDING_MODEL="text-embedding-3-small" # dims: 1536

# Sandbox send behaviour
SANDBOX_SEND=true # if true, messages are NOT actually sent; they are only logged and stored

# App settings
DB_NAME="sample_customer_360_19"
PORT=3000
