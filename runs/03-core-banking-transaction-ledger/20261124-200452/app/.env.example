# Copy this file to .env and set DOCUMENTDB_URI
# Example: mongodb+srv://<username>:<password>@cluster-name.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256
DOCUMENTDB_URI=
# Database name to use (do not change unless you know what you're doing)
MONGODB_DATABASE=sample_banking_03
# Server port for the REST API
PORT=3000
