# Example .env - DO NOT store real secrets here
# Set DOCUMENTDB_URI to your Azure DocumentDB (MongoDB wire) connection string.
# Example: mongodb://username:password@host1:10255,host2:10255/?tls=true&replicaSet=globaldb&authSource=admin&retryWrites=false&authMechanism=SCRAM-SHA-256
DOCUMENTDB_URI=

# TTL timeout (in seconds) for cleaning state; set to 300 for 5 minutes by default when seeding
CLEANING_TTL_SECONDS=300

# Database name used by sample
DB_NAME=sample_healthcare_12
