# Copy to .env and fill in values. Do NOT commit secrets.
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
OPENAI_API_KEY=
# Optional: override OpenAI model names
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_NAME=sample_customer_360_09
