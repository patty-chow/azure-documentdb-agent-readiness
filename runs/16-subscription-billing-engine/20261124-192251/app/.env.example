# Copy to .env and fill in the DOCUMENTDB_URI with your cluster connection string.
# Example:
# DOCUMENTDB_URI="mongodb://username:password@host:10260/?tls=true&replicaSet=globaldb"
DOCUMENTDB_URI="<your_documentdb_connection_string_here>"

# Optional: change database name (defaults to sample_fintech_16)
DATABASE_NAME=sample_fintech_16
