# DocumentDB (MongoDB-compatible) connection string. Read from env at runtime.
# Example (do NOT commit real credentials):
# mongodb://username:password@host:port/?ssl=true&replicaSet=rs0&authSource=admin
DOCUMENTDB_URI=

# Optional: OpenAI API key for generating narratives
OPENAI_API_KEY=

# Database name used by the sample
DB_NAME=sample_banking_01
