# Copy this file to .env and fill values. Do NOT check real secrets into source control.
# URI to the Azure DocumentDB cluster (mongodb+srv://...)
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongo.cosmos.azure.com/?ssl=true&replicaSet=globaldb&retryWrites=false

# Optional OpenAI settings for the LangChain agent. Leave blank to use a stub summarizer for local runs/tests.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# Database name used by this sample
DOCUMENTDB_DATABASE=sample_banking_01
