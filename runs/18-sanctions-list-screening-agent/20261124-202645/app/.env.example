# Copy to .env and fill in
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/<dbname>?ssl=true&replicaSet=globaldb"
OPENAI_API_KEY="<your-openai-key>"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
# Screening thresholds
VECTOR_WEIGHT=0.7
REGEX_WEIGHT=0.3
HIGH_CONFIDENCE=0.8
MEDIUM_CONFIDENCE=0.5
