# Azure DocumentDB connection (mongodb+srv URI or mongodb URI)
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true

# OpenAI API key for embeddings and LLM (optional for offline demo)
OPENAI_API_KEY=

# Optional: number of seed documents to create
SEED_COUNT=200

# API server settings
API_HOST=127.0.0.1
API_PORT=8000

# Embedding model and dims
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# Number of neighbors to return
TOP_K=5
