# Copy this file to .env and fill in real values.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?retryWrites=false&w=majority"
# OpenAI API key for embeddings / optional LLM rewrite
OPENAI_API_KEY="your-openai-key"
# Embedding model and dimensions (defaults used by sample)
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMS=1536
