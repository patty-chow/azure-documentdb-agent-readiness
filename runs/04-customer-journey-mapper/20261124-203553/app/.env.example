# Copy this file to .env and fill values before running
# Azure DocumentDB connection string (SRV or standard). Do NOT commit secrets.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256"
# OpenAI API key (or other LLM provider key). The sample uses OpenAI-compatible API.
OPENAI_API_KEY="your-openai-key"
# Chat model to use for summaries (override as desired)
MODEL_NAME="gpt-4o-mini"
# Database name used by the sample
DOCUMENTDB_DB_NAME="sample_customer_360_04"
