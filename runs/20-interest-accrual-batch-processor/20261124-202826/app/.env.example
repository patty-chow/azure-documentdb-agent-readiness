# Copy to .env and set your DocumentDB connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256
DOCUMENTDB_URI=

# Optional adjustments
DB_NAME=sample_banking_20
BATCH_SIZE=500
CRON_SCHEDULE="0 0 * * *" # midnight UTC
