{
  "name": "documentdb-interest-accrual",
  "version": "0.1.0",
  "description": "Sample: daily batch processor that accrues interest and writes immutable journals to Azure DocumentDB using Mongoose",
  "main": "src/worker.js",
  "scripts": {
    "start": "node src/worker.js",
    "start:once": "node src/worker.js --once",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "keywords": ["azure","documentdb","mongoose","batch","interest"],
  "author": "Sample Builder",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "mongoose": "^7.5.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sinon": "^15.2.0",
    "mongodb-memory-server": "^8.14.0"
  }
}
