# Copy to .env and edit with real values
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/<dbname>?ssl=true&replicaSet=globaldb
# Optional: OpenAI API key for real embeddings & LLM. If not provided the sample will use deterministic pseudo-embeddings and a template response.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
