# Copy this file to .env and fill in real values for local testing.
# Never commit real secrets.

DOCUMENTDB_URI="<your DocumentDB connection string here>"
OPENAI_API_KEY="<your OpenAI API key>"
# Optional: model to use (gpt-3.5-turbo, gpt-4, etc.)
OPENAI_MODEL="gpt-3.5-turbo"

# Optional provider placeholders (not required for sample runs since sends are simulated)
TWILIO_ACCOUNT_SID="<twilio sid>"
TWILIO_AUTH_TOKEN="<twilio token>"
SENDGRID_API_KEY="<sendgrid api key>"
