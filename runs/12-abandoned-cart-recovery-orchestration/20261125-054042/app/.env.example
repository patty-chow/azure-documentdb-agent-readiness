# Copy this file to .env and fill in values. Do NOT commit real secrets.
DOCUMENTDB_URI="<your-DocumentDB-connection-string-here>"
OPENAI_API_KEY="<your-openai-api-key>"
# Optional delivery provider credentials (if you want to send real messages)
SENDGRID_API_KEY="<sendgrid-api-key>"
TWILIO_ACCOUNT_SID="<twilio-account-sid>"
TWILIO_AUTH_TOKEN="<twilio-auth-token>"
TWILIO_FROM_NUMBER="<twilio-from-number>"
