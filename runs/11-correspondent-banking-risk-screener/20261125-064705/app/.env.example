# Copy this file to .env and fill in the real values (do NOT commit real secrets)
DOCUMENTDB_URI=mongodb://<username>:<password>@host:port/?ssl=true&replicaSet=globaldb
OPENAI_API_KEY=sk-<your-openai-key>
# Optionally set OPENAI_API_BASE for Azure OpenAI endpoints
# OPENAI_API_BASE=https://your-azure-openai-endpoint
