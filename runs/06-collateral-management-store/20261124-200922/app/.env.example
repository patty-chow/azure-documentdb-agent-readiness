# Copy to .env and fill in values. Do NOT commit secrets.
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<clustername>.mongocluster.cosmos.azure.com/?tls=true&retryWrites=false
# OpenAI API key for LLM classification (optional). Set DISABLE_LLM=true to skip classification in dev.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# Set to 'true' to bypass LLM calls (useful for offline seed/run)
DISABLE_LLM=true
PORT=3000

# Optional embedding settings (not used by default)
EMBEDDING_DIM=1536
