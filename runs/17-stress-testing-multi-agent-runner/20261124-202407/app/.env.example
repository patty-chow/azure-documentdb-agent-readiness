# Copy to .env and fill with real values
# DocumentDB connection string (SRV or standard). Example:
# mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256
DOCUMENTDB_URI="YOUR_DOCUMENTDB_URI_HERE"

# Optional: OpenAI API key for LLM-based reporting (optional)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Database name used by this sample
DB_NAME=sample_banking_17
