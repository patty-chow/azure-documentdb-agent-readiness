# Copy to .env and fill in the real values. Never commit real secrets.
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongocluster.cosmos.azure.com/?tls=true
OPENAI_API_KEY=your-openai-key-here
# Optional: override to use local DocumentDB gateway for development
# DOCUMENTDB_URI=mongodb://localhost:10260/?tls=true&tlsAllowInvalidCertificates=true
