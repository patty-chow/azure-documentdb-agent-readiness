# Example .env for the sample. Do NOT commit secrets. Set real values in your environment.
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?tls=true&authSource=admin&authMechanism=SCRAM-SHA-256&retryWrites=false&serverSelectionTimeoutMS=30000
DOCUMENTDB_DATABASE=sample_healthcare_18
# Optional: OpenAI API key for extraction. If absent, seed.py will insert pre-parsed sample docs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
