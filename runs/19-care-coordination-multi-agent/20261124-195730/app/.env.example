# Copy this file to .env and fill in the values. DO NOT commit real secrets.
DOCUMENTDB_URI="mongodb+srv://username:password@<cluster>.mongocluster.cosmos.azure.com"
# Optional: OpenAI-compatible API key for LLM and embeddings
OPENAI_API_KEY="sk-..."
# Optional: override default LLM model and embedding model names
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Database name used by this sample (leave as-is unless you know what you're doing)
DOCUMENTDB_DB="sample_healthcare_19"
