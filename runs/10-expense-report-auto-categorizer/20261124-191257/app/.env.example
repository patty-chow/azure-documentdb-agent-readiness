# Copy to .env and fill in real values. Never commit real secrets.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<your-cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256"
# Optional: OpenAI API key used by the LangChain agent. If not set, the sample runs a deterministic fallback.
OPENAI_API_KEY=
USE_AI=true

# Database name used by the sample
DOCUMENTDB_DB=sample_fintech_10
