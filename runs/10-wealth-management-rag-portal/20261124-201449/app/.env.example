# Connection string to the Azure DocumentDB cluster (Mongo endpoint)
DOCUMENTDB_URI="mongodb://username:password@host:port/?tls=true&authSource=admin"

# Optional OpenAI API key for embeddings and chat
OPENAI_API_KEY=""

# Optional: OpenAI models (change as desired)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Database name used by the sample
DATABASE_NAME="sample_banking_10"
