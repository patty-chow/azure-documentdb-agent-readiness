# Copy to .env and fill in the values. Do NOT check secrets into source control.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false"
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL_CHAT="gpt-4o-mini"
OPENAI_MODEL_EMBEDDING="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
DATABASE_NAME=sample_customer_360_17
