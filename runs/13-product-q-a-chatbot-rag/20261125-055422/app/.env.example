# Copy this file to .env and fill in values. Do NOT check your secrets into source control.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256"
# Embedding model and dimensions used by this sample
EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMS=1536
# OpenAI API key (optional, required if you want real embeddings and generation)
OPENAI_API_KEY=""
# LLM model name for generation (configurable)
LLM_MODEL="gpt-4o-mini"

# Database/collections used by the sample (leave as-is to match the sample behavior)
DB_NAME="sample_retail_13"
PRODUCTS_COLLECTION="products"
CHUNKS_COLLECTION="product_chunks"
