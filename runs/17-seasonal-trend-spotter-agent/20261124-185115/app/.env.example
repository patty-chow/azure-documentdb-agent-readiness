# Example environment variables (do NOT store real secrets here)
DOCUMENTDB_URI="<your-mongodb-connection-string>"
# Optional: OpenAI API key for LLM summarization
OPENAI_API_KEY=""
# Optional: Bing Web Search API (Azure) key and endpoint
BING_API_KEY=""
BING_ENDPOINT="https://api.bing.microsoft.com/v7.0/search"
# Toggle to run integration against live cluster in tests
TEST_WITH_LIVE="false"
