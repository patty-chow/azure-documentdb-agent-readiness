# Copy this file to .env and fill in the real values
# DOCUMENTDB_URI must contain the MongoDB connection string for the DocumentDB cluster.
DOCUMENTDB_URI="mongodb://<username>:<password>@your-cluster.mongocluster.cosmos.azure.com:10260/?tls=true&authMechanism=SCRAM-SHA-256"
# Optional OpenAI key for real LLM calls. If not provided, the sample can run in --mock mode for testing.
OPENAI_API_KEY="your-openai-key"
