# Connection string for Azure DocumentDB (MongoDB-compatible)
DOCUMENTDB_URI=mongodb://<username>:<password>@<your-cluster>.mongocluster.cosmos.azure.com:10260/?tls=true&replicaSet=globaldb&authMechanism=SCRAM-SHA-256

# (Optional) OpenAI API key used by LangChain (if you want LLM scoring). Do NOT commit real keys.
OPENAI_API_KEY=
