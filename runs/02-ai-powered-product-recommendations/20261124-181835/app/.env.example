# Azure DocumentDB (MongoDB wire protocol) connection string. Example: mongodb://username:password@host:10260/?ssl=true&replicaSet=globaldb
DOCUMENTDB_URI=

# Optional: OpenAI API key for embeddings and LLM reasoning. If not set, the sample will generate deterministic synthetic embeddings and template reasoning.
OPENAI_API_KEY=

# Optional: Embedding model and dimensions if using a different provider/model. Defaults are used by the sample.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
