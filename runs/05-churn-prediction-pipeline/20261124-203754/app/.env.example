# Copy to .env and fill in values. Do NOT commit secrets to git.
DOCUMENTDB_URI=mongodb://<username>:<password>@my-cluster.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb

# Optional OpenAI (or Azure OpenAI) settings for embeddings & LLM usage
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_API_BASE=
