# Copy to .env and fill in values (DO NOT CHECK IN real secrets)
DOCUMENTDB_URI="mongodb+srv://[USER]:[PASSWORD]@[CLUSTER_URI]/?tls=true&authMechanism=SCRAM-SHA-256"
OPENAI_API_KEY="[YOUR_OPENAI_API_KEY]"
EMBEDDING_DIMS=1536
USE_SERVER_SEARCH=false  # set true to attempt server-side $search (requires server-side vector index and embeddings)
