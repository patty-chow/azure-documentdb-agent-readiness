# Copy to .env and fill in the values. Do NOT commit your real credentials.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256"
PORT=3000
# Optional: if you provide OPENAI_API_KEY the agent code can be extended to call OpenAI; not required for the demo.
OPENAI_API_KEY=
