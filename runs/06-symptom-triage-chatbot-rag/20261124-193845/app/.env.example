# Copy this file to .env and fill in real values. Do NOT commit real secrets.
# Connection string to the Azure DocumentDB cluster (mongodb+srv URI)
DOCUMENTDB_URI=mongodb+srv://<username>:<password>@<cluster>.global.mongocluster.cosmos.azure.com

# Optional OpenAI API key for embeddings + LLM. If omitted, the sample will use a deterministic fallback for offline testing.
OPENAI_API_KEY=your-openai-key

# Embedding and LLM model names (optional overrides)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
LLM_MODEL=gpt-3.5-turbo
