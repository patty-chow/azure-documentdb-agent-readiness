# Copy this file to .env and fill in the values before running the sample
DOCUMENTDB_URI=[YOUR_DOCUMENTDB_CONNECTION_URI]
# OpenAI API key (optional). If not provided, the seed script will generate deterministic synthetic embeddings instead.
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
# Optional: OpenAI base URL (for Azure OpenAI set OPENAI_API_BASE)
OPENAI_API_BASE=
# Embedding model and dimension used by the sample (do not change unless you also recreate the index to match dimensions)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
