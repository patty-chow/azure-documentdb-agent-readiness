# Connection string to the Azure DocumentDB cluster (mongodb+srv://...)
DOCUMENTDB_URI="<your-documentdb-connection-string>"

# Optional: OpenAI API key if you want to generate real embeddings
# OPENAI_API_KEY="sk-..."

# Optional toggle: if true and OPENAI_API_KEY set, the sample will call OpenAI for embeddings
# USE_OPENAI_EMBEDDINGS=false
