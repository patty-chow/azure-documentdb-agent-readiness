# Copy to .env and fill in or export these values in your shell
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<your-cluster>.mongocluster.cosmos.azure.com/?tls=true"
# OpenAI API key (optional for running the LLM agent)
OPENAI_API_KEY="sk-..."
# Model name used by LangChain Chat model
MODEL="gpt-4"
