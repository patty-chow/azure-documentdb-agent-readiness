# Copy to .env and fill with real values (do NOT commit secrets)
DOCUMENTDB_URI="<your DocumentDB MongoDB connection string here>"
# Optional: override DB name (defaults to sample_healthcare_08)
# DOCUMENTDB_DB=sample_healthcare_08

# OpenAI API key for LLM usage (optional). If not provided, agents use deterministic fallbacks.
OPENAI_API_KEY="<your-openai-api-key>"
# Chat model name (e.g., gpt-4o-mini). Change as desired.
CHAT_MODEL="gpt-4o-mini"
